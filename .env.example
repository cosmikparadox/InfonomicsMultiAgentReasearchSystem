# Anthropic API Key (required)
RESEARCH_ANTHROPIC_API_KEY=sk-ant-...

# Model selection (optional, defaults shown)
RESEARCH_DEFAULT_MODEL=claude-sonnet-4-6
RESEARCH_ORCHESTRATOR_MODEL=claude-sonnet-4-6
RESEARCH_CRITIC_MODEL=claude-sonnet-4-6

# Research parameters (optional)
RESEARCH_MAX_REFINEMENT_ROUNDS=3
RESEARCH_MAX_TOKENS_PER_REQUEST=8192
RESEARCH_CRITIQUE_THRESHOLD=0.7

# Output
RESEARCH_OUTPUT_DIR=data/outputs
RESEARCH_LOG_LEVEL=INFO
